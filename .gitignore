# live-build working state and output (regenerated by build.sh)
/.build/
/binary/
/cache/
/chroot/
/local/
/dist/
/binary.modified_timestamps
/chroot.files
/chroot.packages.*
/live-image-*
*.iso

# Generated by `lb config` from auto/config on every build
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source

# live-build's stock hooks, symlinked in by `lb config`.
# Name project hooks with a 3-digit prefix (e.g. 020-*) so they are tracked.
/config/hooks/live/[0-9][0-9][0-9][0-9]-*
/config/hooks/normal/[0-9][0-9][0-9][0-9]-*

# Local tool state
/.codex
